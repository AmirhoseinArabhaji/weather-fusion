# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=weather-fusion
APP_ENV=development
APP_PORT=8080
APP_VERSION=v0.1.0

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=weather
DB_PASSWORD=weather_secret
DB_NAME=weather_fusion
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=300

# ─── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0
CACHE_TTL_SECONDS=300

# ─── Weather Providers ────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHERAPI_KEY=your_weatherapi_key_here
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
VISUALCROSSING_API_KEY=your_visualcrossing_api_key_here
VISUALCROSSING_BASE_URL=https://weather.visualcrossing.com/VisualCrossingWebServices/rest/services/timeline
TOMORROWIO_API_KEY=your_tomorrowio_api_key_here
TOMORROWIO_BASE_URL=https://api.tomorrow.io/v4

# ─── LLM ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_TOKENS=512

# ─── Security ────────────────────────────────────────────────────────────────
API_KEY_HEADER=X-API-Key
JWT_SECRET=change_me_to_a_long_random_secret

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=text
